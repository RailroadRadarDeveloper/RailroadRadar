rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Every email-based check goes through here, so an unverified email never counts.
    function authEmailLower() {
      return signedIn() && request.auth.token.email is string
          && request.auth.token.email_verified == true
        ? request.auth.token.email.lower()
        : '';
    }

    function isBootstrapAdmin() {
      return signedIn()
        && authEmailLower() in ['turokerr@gmail.com', 'railroadradar@gmail.com'];
    }

    function adminDocPath() {
      return /databases/$(database)/documents/admins/$(authEmailLower());
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (signedIn() && exists(adminDocPath()));
    }

    // Train icons are drawn into the page, so only plain /assets/ image paths are allowed.
    function iconIsAsset(data) {
      return !('icon' in data)
        || (data.icon is string && data.icon.matches('/assets/[A-Za-z0-9-]+[.]png'));
    }

    function adminHasPerm(perm) {
      return isBootstrapAdmin()
        || (isAdmin()
            && get(adminDocPath()).data.perms[perm] == true);
    }

    function verifiedEmail() {
      return authEmailLower() != '';
    }

    // Raw token email, lowercased like bannedEmails doc ids. Verification is not required here:
    // matching an unverified address can only restrict the caller, never grant access.
    function tokenEmailLower() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function isBanned() {
      return signedIn() && (
        exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid))
        || (tokenEmailLower() != ''
            && exists(/databases/$(database)/documents/bannedEmails/$(tokenEmailLower())))
      );
    }

    // Signed in and not banned: required for every user-side write and private read.
    function activeUser() {
      return signedIn() && !isBanned();
    }

    match /pairings/{leadCar} {
      allow read: if true;
      allow create, update: if signedIn()
        && verifiedEmail()
        && !isBanned()
        && request.resource.data.leadCar == leadCar
        && request.resource.data.leadCar is string
        && request.resource.data.leadCar.size() <= 64
        && request.resource.data.engine is string
        && request.resource.data.engine.size() <= 64
        && request.resource.data.keys().hasAll(['leadCar', 'engine', 'reportedByUid', 'updatedAt'])
        && request.resource.data.reportedByUid == request.auth.uid;
      allow delete: if activeUser()
        && resource.data.reportedByUid == request.auth.uid;
    }

    match /trainReports/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && !isBanned() && verifiedEmail()
        && (request.resource.data.reportedByUid == request.auth.uid || isAdmin());
      allow delete: if isBootstrapAdmin()
        || adminHasPerm('deleteReports')
        || (activeUser() && resource.data.reportedByUid == request.auth.uid);
    }

    match /pendingReports/{id} {
      allow read: if isAdmin()
        || (activeUser() && resource.data.reportedByUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.reportedByUid == request.auth.uid
        && !isBanned() && verifiedEmail();
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (activeUser() && resource.data.reportedByUid == request.auth.uid);
    }

    match /reportHold/{uid} {
      allow read: if isAdmin()
        || (activeUser() && request.auth.uid == uid);
      allow create, update, delete: if isBootstrapAdmin() || isAdmin();
    }

    match /reportAudit/{id} {
      allow read: if isAdmin();
      allow create, update: if signedIn()
        && !isBanned() && verifiedEmail()
        && (request.resource.data.reportedByUid == request.auth.uid || isAdmin());
      allow delete: if isBootstrapAdmin()
        || adminHasPerm('deleteReports')
        || (activeUser() && resource.data.reportedByUid == request.auth.uid);
    }

    match /actionLog/{id} {
      allow read: if isAdmin();
      allow create: if activeUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['action', 'uid', 'at']);
      allow update: if false;
      allow delete: if isBootstrapAdmin();
    }

    match /userSettings/{uid} {
      allow read, write: if activeUser() && request.auth.uid == uid;
    }

    match /bannedUsers/{id} {
      // Admins list/read all; self may read own ban doc by uid
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == id);
      allow create, update, delete: if isBootstrapAdmin() || adminHasPerm('banUsers');
    }

    match /bannedEmails/{email} {
      allow read: if isAdmin()
        || (signedIn() && authEmailLower() == email);
      allow create, update, delete: if isBootstrapAdmin() || adminHasPerm('banUsers');
    }

    match /admins/{email} {
      // Own doc readable so the client can detect admin status; full list only for admins
      allow read: if isAdmin()
        || (signedIn() && authEmailLower() == email);
      allow create, update, delete: if isBootstrapAdmin()
        || adminHasPerm('manageAdmins');
    }

    match /specialUnits/{id} {
      allow read: if true; // needed for all clients to build roster
      allow create, update, delete: if isBootstrapAdmin() || isAdmin();
    }

    match /verifiedReporters/{uid} {
      allow read: if true; // show checkmarks on others' names
      allow create, update, delete: if isBootstrapAdmin() || isAdmin();
    }

    // Username claims for public profiles (doc id = lowercased username)
    match /usernames/{name} {
      allow read: if true;
      allow create: if activeUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && name == request.resource.data.username.lower();
      allow update: if activeUser()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && name == request.resource.data.username.lower();
      allow delete: if activeUser() && resource.data.uid == request.auth.uid;
    }

    // Lean public card only (no email). Written when user opts in / updates profile.
    match /publicProfiles/{uid} {
      allow read: if true;
      allow create, update: if activeUser()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.keys().hasAll(['uid', 'username', 'displayName', 'photoURL'])
        && (request.resource.data.displayName == null || request.resource.data.displayName is string)
        && (request.resource.data.photoURL == null || request.resource.data.photoURL is string);
      allow delete: if activeUser() && request.auth.uid == uid;
    }

    // Trip log: lean per-trip docs (+ optional segments[]) + summary on userSettings/{uid}.tripLogStats
    // Public read only when that user's publicProfiles/{uid} exists (opt-out removes the doc).
    match /tripLogs/{id} {
      allow read: if isAdmin()
        || (activeUser() && resource.data.userId == request.auth.uid)
        || (resource.data.hiddenPublic == false
            && exists(/databases/$(database)/documents/publicProfiles/$(resource.data.userId)));
      allow create: if signedIn()
        && !isBanned() && verifiedEmail()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'userId', 'railroad', 'originStationId', 'originName',
          'destStationId', 'destName', 'trainNumber', 'startTime', 'miles'
        ])
        && request.resource.data.railroad is string
        && request.resource.data.trainNumber is string
        && request.resource.data.miles is number
        && (!('segments' in request.resource.data)
            || request.resource.data.segments is list)
        && (!('endTime' in request.resource.data)
            || request.resource.data.endTime is string
            || request.resource.data.endTime == null)
        && iconIsAsset(request.resource.data);
      allow update: if activeUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && iconIsAsset(request.resource.data);
      allow delete: if activeUser() && resource.data.userId == request.auth.uid;
    }


    // Shared lean cache of observed/past stop departure times for live train popups.
    // Public read, signed-in write: values are derived from public GTFS/realtime feeds (not PII).
    // Schema-validated; size-capped. Admins may delete stale docs.
    match /trainStopActuals/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && verifiedEmail()
        && !isBanned()
        && request.resource.data.keys().hasAll([
          'agency', 'trainNumber', 'serviceDate', 'stops', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.agency is string
        && request.resource.data.trainNumber is string
        && request.resource.data.serviceDate is string
        && request.resource.data.stops is list
        && request.resource.data.stops.size() <= 80
        && request.resource.data.agency.size() <= 32
        && request.resource.data.trainNumber.size() <= 64
        && request.resource.data.serviceDate.size() <= 16;
      allow delete: if isBootstrapAdmin() || isAdmin();
    }


    // Live location shares: public only while unexpired. Queries must filter expireAt > now.
    // expireAt (timestamp) also drives the Firestore TTL policy that deletes old shares.
    match /specialMoveShares/{uid} {
      // Firestore can't check request.time against each doc in a list query, so listing is limited to
      // active shares (query must filter active == true); single gets also require an unexpired share.
      // Expired-but-active leftovers are removed by the sharer's client and the TTL policy on expireAt.
      allow get: if isAdmin()
        || (activeUser() && request.auth.uid == uid)
        || (resource.data.active == true
            && resource.data.expireAt is timestamp && resource.data.expireAt > request.time);
      allow list: if isAdmin() || resource.data.active == true;
      allow create, update: if activeUser()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.lat is number
        && request.resource.data.lon is number
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt <= request.time + duration.value(6, 'h')
        && (!('recent' in request.resource.data)
            || (request.resource.data.recent is list && request.resource.data.recent.size() <= 10))
        && iconIsAsset(request.resource.data);
      // Admins clean up expired shares (no TTL on the free plan).
      allow delete: if (activeUser() && request.auth.uid == uid) || isAdmin();
    }

    match /tracksideFavorites/{id} {
      allow read: if true;
      allow create, update, delete: if isBootstrapAdmin() || isAdmin();
    }
    match /accounts/{uid} {
      // Admins list all; each user may read/write only their own mirror doc
      allow read: if isAdmin()
        || (activeUser() && request.auth.uid == uid);
      allow create, update: if activeUser() && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if isBootstrapAdmin() || isAdmin()
        || (activeUser() && request.auth.uid == uid);
    }

    // Ban appeals: banned users are signed out, so create is open but tightly validated.
    // Doc id = the banned uid, so each uid gets exactly one appeal (create only, no overwrite).
    match /banAppeals/{uid} {
      allow create: if uid.size() > 0 && uid.size() <= 128
        && request.resource.data.keys().hasOnly(['uid', 'email', 'reason', 'message', 'createdAt', 'status'])
        && request.resource.data.keys().hasAll(['uid', 'message', 'createdAt', 'status'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && (!('email' in request.resource.data)
            || (request.resource.data.email is string && request.resource.data.email.size() <= 320))
        && (!('reason' in request.resource.data)
            || (request.resource.data.reason is string && request.resource.data.reason.size() <= 1000))
        && (exists(/databases/$(database)/documents/bannedUsers/$(uid))
            || ('email' in request.resource.data
                && request.resource.data.email.size() > 0
                && exists(/databases/$(database)/documents/bannedEmails/$(request.resource.data.email))));
      allow read, update, delete: if isAdmin();
    }

    // Unban markers: lets a signed-out, formerly banned browser learn it may clear its lock.
    // Keyed by a random status token (>= 32 chars) stored only in the admin-only ban doc
    // and the banned user's browser, so ban history can't be looked up by uid.
    match /unbanned/{token} {
      allow get: if token.size() >= 32;
      allow list: if isAdmin();
      allow delete: if isBootstrapAdmin() || adminHasPerm('banUsers');
      allow create, update: if (isBootstrapAdmin() || adminHasPerm('banUsers')) && token.size() >= 32;
    }

    // Appeal decision visible to the signed-out appellant by status token (status, dates, deny reason only).
    match /appealStatus/{token} {
      allow get: if token.size() >= 32;
      allow list: if isAdmin();
      allow delete: if isBootstrapAdmin() || adminHasPerm('banUsers');
      allow create, update: if (isBootstrapAdmin() || adminHasPerm('banUsers'))
        && token.size() >= 32
        && request.resource.data.keys().hasOnly(['status', 'createdAt', 'denyReason', 'decidedAt'])
        && request.resource.data.status in ['open', 'approved', 'denied']
        && (!('denyReason' in request.resource.data)
            || (request.resource.data.denyReason is string && request.resource.data.denyReason.size() <= 1000));
    }

    match /pressReleases/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pressReleases/{id}/comments/{cid} {
      allow read: if true;
      allow create: if request.auth != null
        && verifiedEmail()
        && !isBanned()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && !('email' in request.resource.data)
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 80
                && !request.resource.data.displayName.matches('.*@.*')));
      // Admin-only scrub of legacy comments: may only drop the email field and replace an
      // email-looking displayName; nothing else can change.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName'])
        && !('email' in request.resource.data)
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 80
                && !request.resource.data.displayName.matches('.*@.*')));
      allow delete: if request.auth != null && (
        (activeUser() && request.auth.uid == resource.data.uid) || isAdmin()
      );
    }
  }
}
