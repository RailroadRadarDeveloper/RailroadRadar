rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function authEmailLower() {
      return verifiedEmail() ? request.auth.token.email.lower() : '';
    }

    function isBootstrapAdmin() {
      return authEmailLower() in ['turokerr@gmail.com', 'railroadradar@gmail.com'];
    }

    function adminDocPath() {
      return /databases/(default)/documents/admins/$(authEmailLower());
    }

    // Storage rules allow at most two Firestore document lookups per request.
    // The admin ban workflow always writes bannedUsers/{uid}; use that canonical
    // record here and avoid a third lookup for bannedEmails/{email}.
    function isBanned() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/bannedUsers/$(request.auth.uid));
    }

    // Match Firestore's admin definition: bootstrap admins or an enabled permission.
    function hasAdminPermission() {
      return isBootstrapAdmin()
        || (firestore.exists(adminDocPath())
          && (
            firestore.get(adminDocPath()).data.get('perms', {}).get('viewReports', false) == true
            || firestore.get(adminDocPath()).data.get('perms', {}).get('banUsers', false) == true
            || firestore.get(adminDocPath()).data.get('perms', {}).get('manageAdmins', false) == true
            || firestore.get(adminDocPath()).data.get('perms', {}).get('deleteReports', false) == true
          ));
    }

    function activeAdmin() {
      return verifiedEmail() && !isBanned() && hasAdminPermission();
    }

    // Press release images
    match /press/{slug}/{fileName} {
      allow read: if true;
      allow write: if activeAdmin()
        && request.resource.size < 8 * 1024 * 1024
        // Only raster formats are accepted; SVG can contain active script content.
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }
  }
}
