) >= 30:
                chains.append(c)
    kept = []
    for c in sorted(chains, key=length, reverse=True):
        if any(contained(c, k) for k in kept):
            continue
        kept.append(c)
    polys = [simplify(c) for c in kept]
    polys = [p for p in polys if len(p) >= 2]
    print("%s %s polys %d pts %d" % (rid, name, len(polys), sum(len(p) for p in polys)))
   