def hav(a, b):
    dy = (b[0] - a[0]) * 111.0
    dx = (b[1] - a[1]) * 111.0 * math.cos(math.radians((a[0] + b[0]) / 2))
    return math.hypot(dx, dy)

def dedupe(pts, min_km=0.02):
    out = []
    for p in pts:
        if not out or hav(out[-1], p) >= min_km:
            out.append(p)
    return out

