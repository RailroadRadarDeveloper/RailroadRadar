range(0, len(a), step):
        p = a[i]
        best, bi = 1e9, 0
        for j in range(0, len(b), bs):
            d = hav(p, b[j])
            if d < best:
                best, bi = d, j
        lo, hi = max(0, bi - bs), min(len(b), bi + bs + 1)
        for j in range(lo, hi):
            d = hav(p, b[j])
            if d < best:
                best = d
        n += 1
   