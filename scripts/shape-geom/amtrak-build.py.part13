ged = True
                    elif hav(c[0], o[0]) <= 0.12:
                        c[:] = list(reversed(o))[:-1] + c; used[j] = True; grew = True; changed = True
            nxt.append(c)
        chains = nxt
    return [c for c in chains if len(c) >= 2]

